<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.oryxos</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>oryxos-cli</artifactId>
    <name>OryxOS CLI</name>
    <description>CLI entry point (Picocli subcommands)</description>
    <dependencies>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.oryxos.cli.OryxOsCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
